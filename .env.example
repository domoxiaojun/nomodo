READER_BOT_TOKEN=
READER_API_ID=
READER_API_HASH=
READER_ALLOWED_USER_IDS=
READER_ADMIN_USER_IDS=
READER_DATA_PATH=data/reader
READER_DATABASE_PATH=data/reader/reader.sqlite3
READER_HOST=127.0.0.1
READER_PORT=8090
READER_PENDING_TTL=1800
READER_MAX_PENDING_PER_USER=20
# Local uv default; in Compose replace with an address reachable FROM the Reader container.
# Docker Desktop host Worker example: http://host.docker.internal:8080
PARSEHUB_WORKER_URL=http://127.0.0.1:8080
PARSEHUB_WORKER_SECRET=
PARSEHUB_WORKER_TIMEOUT_SECONDS=30
# Optional Notion OAuth; key is 32 bytes, raw or URL-safe base64.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=
NOTION_CREDENTIALS_KEY=
NOTION_DATABASE_PATH=data/notion/notion.sqlite3
# Only enable if the provider has explicitly confirmed PKCE support.
NOTION_PKCE_ENABLED=false
# Enabled by default; users can opt out with /settings llm off.
LLM_ENABLED=true
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# Defaults to high; supported levels depend on the selected model.
# SDK values: none, minimal, low, medium, high, xhigh, max.
LLM_REASONING_EFFORT=high
OPENAI_TIMEOUT_SECONDS=60
LLM_MAX_INPUT_CHARS=120000
LLM_MAX_OUTPUT_TOKENS=4096
LLM_MAX_TOOL_CALLS=4
